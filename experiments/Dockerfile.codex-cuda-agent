FROM nvidia/cuda:12.8.1-devel-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        build-essential \
        ca-certificates \
        cmake \
        curl \
        git \
        git-lfs \
        ninja-build \
        openssh-client \
        pkg-config \
        python-is-python3 \
        python3 \
        python3-dev \
        python3-venv \
        ripgrep \
        xz-utils \
        zstd \
    && rm -rf /var/lib/apt/lists/*
